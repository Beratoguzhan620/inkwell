<Project>
  <ItemGroup>
    <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11 (through Microsoft.EntityFrameworkCore.Sqlite, used by the public demo) is
         reported for the SQLite it bundles. That native SQLite is left out here; the one loaded comes from
         SourceGear.sqlite3 in BlogApp.Data, a build with the fix, and a test checks the version at run time. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.11" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
</Project>
