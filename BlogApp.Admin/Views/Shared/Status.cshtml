@model (string Title, string Description, string Icon)
@{
    ViewData["Title"] = Model.Title;
    if (!(User.Identity?.IsAuthenticated ?? false)) { Layout = "_Bare"; }
}
<div class="empty-state" style="max-width: 560px; margin: 48px auto;">
    <div class="empty-state-icon"><i class="bi @Model.Icon"></i></div>
    <h2>@Model.Title</h2>
    <p>@Model.Description</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Özete dön</a>
</div>
