@model ErrorViewModel
@{
    ViewData["Title"] = "Bir şeyler ters gitti";
}

<div class="container-reading">
    <div class="empty-state mt-4">
        <div class="empty-state-icon"><i class="bi bi-exclamation-triangle"></i></div>
        <h2>Bir şeyler ters gitti</h2>
        <p>İsteğiniz işlenirken beklenmeyen bir hata oluştu. Lütfen biraz sonra tekrar deneyin.</p>
        @if (Model?.ShowRequestId ?? false)
        {
            <p class="small text-muted">İstek kimliği: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ana sayfaya dön</a>
    </div>
</div>
