<footer class="site-footer">
    <div class="container-wide">
        <span><span class="brand-mark me-2" style="width:22px;height:22px;font-size:13px">i</span>Inkwell · © @DateTime.UtcNow.Year</span>
        <nav aria-label="Alt menü">
            <a asp-controller="Home" asp-action="Index">Yazılar</a>
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <a asp-controller="BlogPost" asp-action="Create">Yazı yaz</a>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Register">Kayıt ol</a>
            }
        </nav>
    </div>
</footer>
