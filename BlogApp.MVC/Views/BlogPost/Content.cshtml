@using BlogApp.Application.DTOs.Blog
@model BlogPostDto
@{
    ViewData["Title"] = Model.Title;
}

<article class="container-reading">
    <header class="article-header">
        <a class="category-label" asp-controller="Home" asp-action="Index">@Model.CategoryName</a>
        <h1>@Model.Title</h1>
        <div class="post-meta">
            <span>@Model.AuthorFullName</span><span class="dot"></span><time datetime="@Model.CreatedAt.ToString("yyyy-MM-dd")">@Model.CreatedAt.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</time>
        </div>
    </header>

    <div class="prose" style="white-space: pre-line">@Model.Content</div>
</article>
