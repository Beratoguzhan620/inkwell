@using BlogApp.MVC.Models.BlogPost
@model BlogPostCreateViewModel
@{
    ViewData["Title"] = "Yeni yazı";
}

<div class="container-reading">
    <div class="page-header">
        <div>
            <h1>Yeni yazı</h1>
            <p>Yazınız editör onayından sonra yayınlanır.</p>
        </div>
    </div>

    <partial name="Partials/_Messages" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <form asp-controller="BlogPost" asp-action="Create" method="post" novalidate>
        <div class="mb-3">
            <label class="form-label" asp-for="Title"></label>
            <input class="form-control" asp-for="Title" placeholder="Yazınıza bir başlık verin" />
            <span asp-validation-for="Title"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="CategoryId"></label>
            <select class="form-select" asp-for="CategoryId" asp-items="ViewBag.CategorySelectList">
                <option value="">Kategori seçin</option>
            </select>
            <span asp-validation-for="CategoryId"></span>
        </div>
        <div class="mb-4">
            <label class="form-label" asp-for="Content"></label>
            <textarea class="form-control" asp-for="Content" rows="14"></textarea>
            <span asp-validation-for="Content"></span>
        </div>
        <div class="d-flex gap-2 justify-content-end">
            <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Vazgeç</a>
            <button type="submit" class="btn btn-primary">Onaya gönder</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
