@using BlogApp.MVC.Models.BlogPost
@model BlogPostCreateViewModel

@{
    ViewData["Title"] = "New Post";
}

<!-- Page Header-->
<header class="masthead" style="background-image: url('~/theme/assets/img/home-bg.jpg')">
    <div class="container position-relative px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-md-10 col-lg-8 col-xl-7">
                <div class="site-heading">
                    <h1>New Post</h1>
                    <span class="subheading">Share your thoughts with the world</span>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Create Post Section-->
<section class="py-5">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-lg-10 col-xl-9">

                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">

                        <h2 class="mb-1" style="font-family: 'Lora', serif;">Create a New Post</h2>
                        <p class="text-muted mb-4" style="font-family: 'Open Sans', sans-serif; font-size: 0.9rem;">
                            Fill in the details below and publish your blog post
                        </p>

                        <form asp-action="Create" asp-controller="BlogPost" method="post" novalidate>
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                            @if (ViewBag.ErrorMessage != null)
                            {
                                <div class="alert alert-danger alert-dismissible fade show small py-2" role="alert">
                                    <i class="fas fa-circle-exclamation me-2"></i>@ViewBag.ErrorMessage
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }

                            <!-- Title -->
                            <div class="mb-3">
                                <label asp-for="Title" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-heading text-muted" style="font-size: 0.85rem;"></i>
                                    </span>
                                    <input asp-for="Title"
                                           class="form-control border-start-0 ps-0"
                                           placeholder="Enter an engaging title..." />
                                </div>
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <!-- Category -->
                            <div class="mb-4">
                                <label asp-for="CategoryId" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-folder-open text-muted" style="font-size: 0.85rem;"></i>
                                    </span>
                                    <select asp-for="CategoryId"
                                            asp-items="ViewBag.CategorySelectList"
                                            class="form-select border-start-0">
                                            <option value="" selected disabled>— Select a category —</option>

                                    </select>
                                </div>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>

                            <!-- Content (TinyMCE) -->
                            <div class="mb-4">
                                <label asp-for="Content" class="form-label fw-semibold small"></label>
                                <textarea asp-for="Content"
                                          id="tinymce-editor"
                                          class="form-control"
                                          rows="12"></textarea>
                                <span asp-validation-for="Content" class="text-danger small"></span>
                            </div>

                            <!-- Actions -->
                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="Index" asp-controller="Home"
                                   class="btn btn-outline-secondary">
                                    <i class="fas fa-xmark me-1"></i>Cancel
                                </a>
                                <button type="submit" class="btn btn-dark px-4">
                                    <i class="fas fa-paper-plane me-2"></i>Publish Post
                                </button>
                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .tox-tinymce {
            border-radius: 0.375rem !important;
            border-color: #dee2e6 !important;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <!-- TinyMCE -->
    <!-- Place the first <script> tag in your HTML's <head> -->
    <script src="https://cdn.tiny.cloud/1/f82yvpr2r2jgp272pm58dysmas20il3gukzwg5liihxo8wk1/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>

    <!-- Place the following <script> and <textarea> tags your HTML's <body> -->
    <script>
        tinymce.init({
        selector: 'textarea',
        plugins: [
        // Core editing features
        'anchor', 'autolink', 'charmap', 'codesample', 'emoticons', 'link', 'lists', 'media', 'searchreplace', 'table', 'visualblocks', 'wordcount',
        ],
        toolbar: 'undo redo | tinymceai-chat tinymceai-quickactions tinymceai-review | blocks fontfamily fontsize | bold italic underline strikethrough | link media table mergetags | addcomment showcomments | spellcheckdialog a11ycheck typography uploadcare | align lineheight | checklist numlist bullist indent outdent | emoticons charmap | removeformat',
        tinycomments_mode: 'embedded',
        tinycomments_author: 'Author name',
        mergetags_list: [
        { value: 'First.Name', title: 'First Name' },
        { value: 'Email', title: 'Email' },
        ],
        tinymceai_token_provider: async () => {
        await fetch(`https://demo.api.tiny.cloud/1/f82yvpr2r2jgp272pm58dysmas20il3gukzwg5liihxo8wk1/auth/random`, { method: "POST", credentials: "include" });
        return { token: await fetch(`https://demo.api.tiny.cloud/1/f82yvpr2r2jgp272pm58dysmas20il3gukzwg5liihxo8wk1/jwt/tinymceai`, { credentials: "include" }).then(r => r.text()) };
        },
        uploadcare_public_key: '3d5e9bf9c7c6a0bd4de0',
        });
    </script>
}
