@model VerificationRequest
@{
    ViewData["Title"] = "E-posta doğrulama";
    var userId = Model?.UserId > 0 ? Model.UserId : ViewBag.UserId as int? ?? 0;
}

<div class="container-reading">
    <div class="auth-panel">
        <h1>E-postanızı doğrulayın</h1>
        <p class="lead-text">Kayıt olduğunuz adrese 6 karakterlik bir kod gönderdik. Kodu girin ya da e-postadaki bağlantıya tıklayın.</p>

        <partial name="Partials/_Messages" />

        @if (TempData["DevelopmentCode"] is string devCode)
        {
            <div class="alert alert-info-soft" role="status">
                <i class="bi bi-wrench"></i>
                <span>Geliştirme modu: e-posta gönderilemedi. Kodunuz <strong class="font-mono">@devCode</strong></span>
            </div>
        }

        <form asp-controller="Auth" asp-action="Verify" method="post" novalidate>
            <input type="hidden" name="UserId" value="@userId" />
            <div class="mb-4">
                <label class="form-label" for="Code">Doğrulama kodu</label>
                <input class="form-control code-input" id="Code" name="Code" maxlength="6" autocomplete="one-time-code" placeholder="······" autofocus required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Doğrula</button>
        </form>

        <p class="auth-switch"><a asp-controller="Auth" asp-action="Login">Giriş sayfasına dön</a></p>
    </div>
</div>
