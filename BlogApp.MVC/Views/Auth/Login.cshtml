@model LoginRequest
@{
    ViewData["Title"] = "Giriş yap";
}

<div class="container-reading">
    <div class="auth-panel">
        <h1>Tekrar hoş geldiniz</h1>
        <p class="lead-text">Yazılarınızı yönetmek ve yorum yapmak için giriş yapın.</p>

        <partial name="Partials/_Messages" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" novalidate>
            <div class="mb-3">
                <label class="form-label" asp-for="Email"></label>
                <input class="form-control" asp-for="Email" type="email" autocomplete="email" autofocus />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Password"></label>
                <input class="form-control" asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check mb-0">
                <input class="form-check-input" asp-for="RememberMe" />
                <label class="form-check-label" asp-for="RememberMe"></label>
            </div>
            <a class="small" asp-controller="Auth" asp-action="ForgotPassword">Şifremi unuttum</a>
            </div>
            <button type="submit" class="btn btn-primary w-100">Giriş yap</button>
        </form>

        <p class="auth-switch">Hesabınız yok mu? <a asp-controller="Auth" asp-action="Register">Kayıt olun</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
