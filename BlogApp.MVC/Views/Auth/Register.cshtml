@model RegisterRequest
@{
    ViewData["Title"] = "Kayıt ol";
}

<div class="container-reading">
    <div class="auth-panel">
        <h1>Yazmaya başlayın</h1>
        <p class="lead-text">Hesabınızı oluşturun; e-postanızı doğruladıktan sonra ilk yazınızı yayınlayabilirsiniz.</p>

        <partial name="Partials/_Messages" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-controller="Auth" asp-action="Register" method="post" novalidate>
            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label class="form-label" asp-for="FirstName"></label>
                    <input class="form-control" asp-for="FirstName" autocomplete="given-name" autofocus />
                    <span asp-validation-for="FirstName"></span>
                </div>
                <div class="col-sm-6">
                    <label class="form-label" asp-for="LastName"></label>
                    <input class="form-control" asp-for="LastName" autocomplete="family-name" />
                    <span asp-validation-for="LastName"></span>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Email"></label>
                <input class="form-control" asp-for="Email" type="email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="mb-4">
                <label class="form-label" asp-for="Password"></label>
                <input class="form-control" asp-for="Password" autocomplete="new-password" aria-describedby="passwordHelp" />
                <div class="form-text" id="passwordHelp">En az 6 karakter.</div>
                <span asp-validation-for="Password"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Hesap oluştur</button>
        </form>

        <p class="auth-switch">Zaten hesabınız var mı? <a asp-controller="Auth" asp-action="Login">Giriş yapın</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
