@model ForgotPasswordRequest
@{
    ViewData["Title"] = "Şifremi unuttum";
}

<div class="container-reading">
    <div class="auth-panel">
        <h1>Şifrenizi mi unuttunuz?</h1>
        <p class="lead-text">Hesabınızın e-posta adresini girin; size yeni şifre belirleme bağlantısı gönderelim.</p>

        <partial name="Partials/_Messages" />

        @if (TempData["DevelopmentLink"] is string devLink)
        {
            <div class="alert alert-info-soft" role="status">
                <i class="bi bi-wrench"></i>
                <span>Geliştirme modu: e-posta gönderilemedi. <a href="@devLink">Şifre sıfırlama bağlantısı</a></span>
            </div>
        }

        <form asp-controller="Auth" asp-action="ForgotPassword" method="post" novalidate>
            <div class="mb-4">
                <label class="form-label" asp-for="Email"></label>
                <input class="form-control" asp-for="Email" type="email" autocomplete="email" autofocus />
                <span asp-validation-for="Email"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Bağlantı gönder</button>
        </form>

        <p class="auth-switch"><a asp-controller="Auth" asp-action="Login">Giriş sayfasına dön</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
