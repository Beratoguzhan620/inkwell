@model PostListViewModel
@{
    ViewData["Title"] = Model.SelectedCategory?.Name ?? (Model.Search is null ? "Yazılar" : $"“{Model.Search}” araması");
    var result = Model.Result;
    string PageUrl(int page) => Url.Action("Index", "Home", new { q = Model.Search, category = Model.CategoryId, page = page > 1 ? page : (int?)null })!;
}

<div class="container-reading">
    @if (!Model.IsFiltered && result.Page == 1)
    {
        <section class="intro">
            <h1>Okumaya değer yazılar, sade bir sayfada.</h1>
            <p>Inkwell'de yazarlar yazılım, teknoloji, bilim, kariyer ve tasarım üzerine yazıyor. Reklam yok, dikkat dağıtan hiçbir şey yok.</p>
        </section>
    }
    else
    {
        <section class="intro">
            <h1>@ViewData["Title"]</h1>
            <p>@result.TotalCount yazı bulundu.</p>
        </section>
    }

    <partial name="Partials/_Messages" />

    <form class="search-form" method="get" asp-controller="Home" asp-action="Index" role="search">
        @if (Model.CategoryId is not null) { <input type="hidden" name="category" value="@Model.CategoryId" /> }
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="form-control" type="search" name="q" value="@Model.Search" placeholder="Yazılarda ara" aria-label="Yazılarda ara" />
    </form>

    <nav class="category-chips" aria-label="Kategoriler">
        <a class="chip @(Model.CategoryId is null ? "active" : null)" href="@Url.Action("Index", "Home", new { q = Model.Search })">Tümü</a>
        @foreach (var category in Model.Categories)
        {
            <a class="chip @(Model.CategoryId == category.Id ? "active" : null)" href="@Url.Action("Index", "Home", new { q = Model.Search, category = category.Id })">
                @category.Name <span class="count">@category.PostCount</span>
            </a>
        }
    </nav>

    @if (result.Items.Count == 0)
    {
        <div class="empty-state mt-4">
            <div class="empty-state-icon"><i class="bi bi-journal-text"></i></div>
            @if (Model.IsFiltered)
            {
                <h2>Eşleşen yazı yok</h2>
                <p>Farklı bir kelimeyle aramayı ya da başka bir kategoriyi deneyin.</p>
                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Tüm yazılar</a>
            }
            else
            {
                <h2>Henüz yayınlanmış yazı yok</h2>
                <p>İlk yazıyı siz yazın.</p>
                <a class="btn btn-primary" asp-controller="BlogPost" asp-action="Create">Yazı yaz</a>
            }
        </div>
    }
    else
    {
        <ol class="post-list">
            @foreach (var post in result.Items)
            {
                <partial name="Partials/_PostItem" model="post" />
            }
        </ol>

        @if (result.TotalPages > 1)
        {
            <nav class="pager" aria-label="Sayfalar">
                @if (result.HasPrevious)
                {
                    <a class="btn btn-outline-secondary" href="@PageUrl(result.Page - 1)"><i class="bi bi-arrow-left"></i>Daha yeni</a>
                }
                else { <span></span> }
                <span class="text-muted small font-mono">@result.Page / @result.TotalPages</span>
                @if (result.HasNext)
                {
                    <a class="btn btn-outline-secondary" href="@PageUrl(result.Page + 1)">Daha eski<i class="bi bi-arrow-right"></i></a>
                }
                else { <span></span> }
            </nav>
        }
    }
</div>
