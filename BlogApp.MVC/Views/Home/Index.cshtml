@using BlogApp.Application.DTOs.Blog
@model List<BlogPostDto>
@{
    ViewData["Title"] = "Yazılar";
}

<div class="container-reading">
    <section class="intro">
        <h1>Okumaya değer yazılar, sade bir sayfada.</h1>
        <p>Inkwell'de yazarlar teknoloji, yazılım ve bilim üzerine yazıyor. Reklam yok, dikkat dağıtan hiçbir şey yok.</p>
    </section>

    @if (Model is null || Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon"><i class="bi bi-journal-text"></i></div>
            <h2>Henüz yayınlanmış yazı yok</h2>
            <p>İlk yazıyı siz yazın; onaylandığında burada görünecek.</p>
            <a class="btn btn-primary" asp-controller="BlogPost" asp-action="Create">Yazı yaz</a>
        </div>
    }
    else
    {
        <ol class="post-list">
            @foreach (var post in Model)
            {
                <li class="post-item">
                    <div>
                        <span class="category-label">@post.CategoryName</span>
                        <h2><a asp-controller="BlogPost" asp-action="Content" asp-route-id="@post.Id">@post.Title</a></h2>
                        <div class="post-meta">
                            <span>@post.AuthorFullName</span><span class="dot"></span><time datetime="@post.CreatedAt.ToString("yyyy-MM-dd")">@post.CreatedAt.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</time>
                        </div>
                    </div>
                </li>
            }
        </ol>
    }
</div>
